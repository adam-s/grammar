{
  "name": "grammar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,svelte,css}\"",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\"",
    "test": "node --test \"src/lib/**/*.test.ts\"",
    "all": "npm run lint && npm run check && npm run test && npm run build",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^0.545.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.3.1"
  }
}
